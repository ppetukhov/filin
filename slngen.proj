<Project Sdk="Microsoft.Build.NoTargets">

  <PropertyGroup>
    <SolutionNameOverride Condition="'$(SolutionNameOverride)' == ''">*</SolutionNameOverride>
  </PropertyGroup>

  <ItemGroup>
    <!-- Unless a "/p:SolutionNameOverride" property is passed in, glob all solutions under src/libraries. -->
    <SolutionFile Include="$(MSBuildThisFileDirectory)$(SolutionNameOverride)\*.slnx"
                  Exclude="$(MSBuildThisFileDirectory)Fuzzing\*.slnx" />
    <SolutionFile Include="$(MSBuildThisFileDirectory)Orca.slnx"
                  Condition="'$(SolutionNameOverride)' == '*' or '$(SolutionNameOverride)' == 'Orca'" />
  </ItemGroup>

  <Target Name="UpdateSolutionFile"
          AfterTargets="Build"
          DependsOnTargets="GetProjectFiles"
          >
    <Exec Command="dotnet new sln -f slnx -n &quot;%(SolutionFile.Filename)&quot;" Condition="!Exists('%(SolutionFile.Identity)')" />
  </Target>

  <Target Name="GetProjectFiles" Outputs="@(AnyProject)">
    <ItemGroup>
      <!-- Add attributes that require a separate item mutation. -->
      <AnyProject Include="$(MSBuildThisFileDirectory)playground\*\*\*.*proj" Exclude="@(ProjectExclusions);" />
      <AnyProject Include="$(MSBuildThisFileDirectory)src\libraries\*\*\*.*proj" Exclude="@(ProjectExclusions);" />
      <AnyProject RelatedPath="$([System.IO.Path]::GetRelativePath('$(MSBuildThisFileDirectory)','%(fullpath)'))" />
      <AnyProject SolutionDir="$([System.IO.Path]::GetDirectoryName('%(AnyProject.RelatedPath)'))" />
    </ItemGroup>
  </Target>
  
  <Target Name="AddProjectToSolution" Inputs="@(AnyProject)" Outputs="%(filename)" AfterTargets="UpdateSolutionFile">
    <Exec Command="dotnet sln &quot;@(SolutionFile->'%(Filename)')@(SolutionFile->'%(extension)')&quot; add &quot;@(AnyProject->'%(fullpath)')&quot; -s &quot;%(AnyProject.SolutionDir)&quot;" />
  </Target>
</Project>
