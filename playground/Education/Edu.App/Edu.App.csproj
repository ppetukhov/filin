<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(NetCurrent)</TargetFramework>
    <NuGetAuditMode>all</NuGetAuditMode>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="$(LibrariesProjectRoot)\Filin.EventStore.Postgres\src\Filin.EventStore.Postgres.csproj" />
    <ProjectReference Include="$(LibrariesProjectRoot)\Filin.ProjectionStore.AdoNet\src\Filin.ProjectionStore.AdoNet.csproj" />
    <ProjectReference Include="..\Edu.Contract\Edu.Contract.csproj" />
    <ProjectReference Include="..\Edu\Edu.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.Development.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
