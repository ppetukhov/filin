<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AnalyzerRoslynVersion>4.3</AnalyzerRoslynVersion>
    <AssemblyName>$(MSBuildThisFileName)</AssemblyName>
    <RootNamespace>$(MSBuildThisFileName)</RootNamespace>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <AnalyzerLanguage>cs</AnalyzerLanguage>
    <LangVersion>preview</LangVersion>
    <DefineConstants Condition="'$(LaunchDebugger)' == 'true'">$(DefineConstants);LAUNCH_DEBUGGER</DefineConstants>

    <!-- https://learn.microsoft.com/en-us/nuget/reference/nuspec?WT.mc_id=DT-MVP-5003978#developmentdependency -->
    <developmentDependency>true</developmentDependency>

    <!-- Do not include the dll into the NuGet package, we'll add it manually at the right location -->
    <IncludeBuildOutput>true</IncludeBuildOutput>
  </PropertyGroup>

  <ItemGroup Label="Package">
    <!-- Include the custom .targets file to check the source generator -->
    <None Include="Filin.Generators.targets" Pack="true" PackagePath="build\;buildMultiTargeting;buildTransitive\" />
  </ItemGroup>
  
</Project>
