<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(NetCurrent);$(NetPrevious);$(NetMinimum)</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <DefineConstants>$(DefineConstants);PROJECTIONSTORE_ADONET</DefineConstants>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(CommonPath)\AdoNet\*.cs" LinkBase="Storage" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="$(CommonPath)\src\AdoNet\ICommandInterceptor.cs" />
    <Compile Remove="$(CommonPath)\src\AdoNet\NoOpDatabaseCommandInterceptor.cs" />
    <Compile Remove="$(CommonPath)\AdoNet\OracleDatabaseCommandInterceptor.cs" />
    <Compile Remove="$(CommonPath)\AdoNet\FilinRelationalDownloadStream.cs" />
    <Compile Remove="$(CommonPath)\AdoNet\RelationalOrleansQueries.cs" />
    <Compile Remove="$(CommonPath)\AdoNet\RelationalStorageExtensions.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(LibrariesProjectRoot)\Filin.Compliance.Classification\src\Filin.Compliance.Classification.csproj" />
    <ProjectReference Include="$(LibrariesProjectRoot)\Filin.Executor\src\Filin.Executor.csproj" />
  </ItemGroup>

</Project>
