<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(NetCurrent);$(NetMinimum)</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <PackageTags>$(PackageTags);projection-store;projectionstore</PackageTags>
    <PackageDescription>ADO.NET-based IProjectionStore implementation for the Filin Event Sourcing framework.</PackageDescription>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(CommonDir)\AdoNet\AdoNetInvariants.cs" LinkBase="Storage" />
    <Compile Include="$(CommonDir)\AdoNet\DbConnectionFactory.cs" LinkBase="Storage" />
    <Compile Include="$(CommonDir)\AdoNet\DbExtensions.cs" LinkBase="Storage" />

    <None Include="Scripts/PostgreSQL-ProjectionStore.sql" Pack="true" Visible="false" PackagePath="/scripts/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Filin.Abstractions\src\Filin.Abstractions.csproj" />
  </ItemGroup>

</Project>
