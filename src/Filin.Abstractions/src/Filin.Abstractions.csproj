<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Filin</RootNamespace>
    <IsPackable>true</IsPackable>
    <TargetFrameworks>$(NetCurrent);$(NetMinimum)</TargetFrameworks>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackInternalAnalyzers</TargetsForTfmSpecificContentInPackage>
    <PackageDescription>Сore interfaces and abstractions for the Filin Event Sourcing framework with native support for Dynamic Consistency Boundaries (DCB).

Commonly Used Types:
Filin.IMediator
Filin.ICommand&lt;TState&gt;
Filin.IQuery&lt;TProjection&gt;
Filin.IProjector&lt;TState&gt;
Filin.IDecider&lt;TCommand, TState&gt;
Filin.Storage.IEventStore
Filin.Storage.IProjectionStore
Filin.EventTypeAttribute
Filin.EventTagAttribute
Filin.QueryEventTypesAttribute
Filin.QueryTagParametersAttribute
Filin.QueryTagsAttribute
Filin.ProjectorIdAttribute
Filin.DeciderAttribute
Filin.DcbQuery
Filin.EventType
Filin.Tag
Filin.EventPosition</PackageDescription>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" />
  </ItemGroup>
  
  <ItemGroup>
    <None Include="..\gen\Filin.Generators.targets" Pack="true" Visible="false" PackagePath="build\$(PackageId).targets;buildMultiTargeting\$(PackageId).targets;buildTransitive\$(PackageId).targets" />
  </ItemGroup>
  
  <Target Name="PackInternalAnalyzers">
    <MSBuild Projects="..\gen\Filin.Generators.csproj" Targets="Build" Properties="Configuration=$(Configuration);TargetFramework=netstandard2.0" />
    
    <MSBuild Projects="..\gen\Filin.Generators.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);TargetFramework=netstandard2.0">
      <Output TaskParameter="TargetOutputs" ItemName="GeneratorAssemblyFile" />
    </MSBuild>

    <ItemGroup>
      <TfmSpecificPackageFile Include="@(GeneratorAssemblyFile)">
        <PackagePath>analyzers/dotnet/cs</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>
</Project>
