<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(NetCurrent);$(NetMinimum)</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <PackageTags>$(PackageTags);event-store;eventstore</PackageTags>
    <PackageDescription>ADO.NET-based IEventStore implementation with Dynamic Consistency Boundary (DCB) support for the Filin Event Sourcing framework.
Currently supports PostgreSQL (Npgsql), with additional database providers planned for future releases.</PackageDescription>
  </PropertyGroup>
 
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(CommonDir)\AdoNet\AdoNetInvariants.cs" LinkBase="Storage" />
    <Compile Include="$(CommonDir)\AdoNet\DbConnectionFactory.cs" LinkBase="Storage" />
    <Compile Include="$(CommonDir)\AdoNet\DbExtensions.cs" LinkBase="Storage" />
    <Compile Include="$(CommonDir)\Text\ValueStringBuilder.cs" LinkBase="Internal" />

    <None Include="Scripts/PostgreSQL-EventStore.sql" Pack="true" Visible="false" PackagePath="/scripts/" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Filin.Abstractions\src\Filin.Abstractions.csproj" />
  </ItemGroup>

</Project>
